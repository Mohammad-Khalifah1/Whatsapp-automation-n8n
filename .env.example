# ==============================================================================
# WhatsApp Support Routing — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# (see .gitignore) and must NEVER be committed. This file (.env.example)
# contains ONLY placeholders — no real secrets, ever.
#
# Full description of every variable: docs/ENVIRONMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# n8n core
# ------------------------------------------------------------------------------
TZ=Asia/Amman
GENERIC_TIMEZONE=Asia/Amman

# n8n's view of its own address, used for editor links and default webhook
# URLs shown in the UI. During local dev with a tunnel, set N8N_HOST to your
# ngrok/Cloudflare Tunnel hostname and N8N_PROTOCOL=https, or leave as-is and
# just use the tunnel URL manually when configuring Meta. See docs/SETUP.md.
N8N_HOST=localhost
N8N_PROTOCOL=http
# N8N_WEBHOOK_URL is the externally-reachable base URL n8n advertises for webhook
# nodes. Set this to your tunnel URL, e.g. https://abcd1234.ngrok-free.app/
N8N_WEBHOOK_URL=http://localhost:5678/

# 64-character hex string used by n8n to encrypt stored credentials.
# Generate with: openssl rand -hex 32   (or any cryptographically secure RNG)
# NEVER reuse this across environments. Losing it makes stored n8n
# credentials unrecoverable; rotating it requires re-entering credentials.
N8N_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ------------------------------------------------------------------------------
# Graph API version to call. Not hard-coded into workflows — change here to
# upgrade. Verify current version at https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v26.0

# Permanent or long-lived System User access token with whatsapp_business_messaging
# and whatsapp_business_management permissions. See docs/META_WHATSAPP_SETUP.md.
META_ACCESS_TOKEN=

# The Phone Number ID (NOT the phone number itself) from the WhatsApp Business
# Platform / Meta Business Manager. Used in the send-message endpoint path.
META_PHONE_NUMBER_ID=

# WhatsApp Business Account ID.
META_WABA_ID=

# App Secret from the Meta App Dashboard. Used to verify the
# X-Hub-Signature-256 HMAC on every incoming webhook request.
META_APP_SECRET=

# Arbitrary string you choose. Meta echoes it back during the GET webhook
# verification handshake (hub.verify_token) — must match exactly.
WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# Google Sheets (MVP operational store — see docs/GOOGLE_SHEETS_TO_POSTGRES.md)
# ------------------------------------------------------------------------------
# The spreadsheet ID (from its URL) containing the Agents/Conversations/
# Messages/Events sheets. See sheets-templates/ and docs/GOOGLE_SHEETS_SCHEMA.md.
GOOGLE_SHEET_ID=

# Service account credentials (Google Cloud Console > IAM > Service Accounts).
# Share the target spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key field from the downloaded JSON key, keeping \n escapes
# literal (do not convert to real newlines in this file).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Business logic configuration
# ------------------------------------------------------------------------------
# Hours of customer inactivity after which a conversation becomes ELIGIBLE for
# closing (does not auto-close in the MVP — see docs/ERROR_HANDLING.md /
# ARCHITECTURE.md state machine section).
CONVERSATION_INACTIVITY_HOURS=24

# Default country calling code (no leading +) used when normalizing local-format
# phone numbers, e.g. Jordanian 07XXXXXXXX -> 9627XXXXXXXX. See docs/ARCHITECTURE.md
# "Phone Number Normalization" section.
DEFAULT_COUNTRY_CODE=962

# Agent selection strategy: LEAST_OPEN_CONVERSATIONS (default) or ROUND_ROBIN.
# An unrecognized value falls back to the default rather than failing.
ASSIGNMENT_STRATEGY=LEAST_OPEN_CONVERSATIONS

# Whether a customer message on a CLOSED conversation reopens it.
REOPEN_CLOSED_CONVERSATIONS=true

# Archiving (workflow 8). Conversations CLOSED for longer than this are moved
# to Conversations_Archive nightly. Set to 0 to disable archiving entirely.
ARCHIVE_AFTER_DAYS=30
# Rows moved per nightly run. Keeps a first, large run inside the write quota.
ARCHIVE_BATCH_SIZE=200

# ------------------------------------------------------------------------------
# Optional: dev tunnel (only needed if you use ngrok's authenticated tier)
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=
