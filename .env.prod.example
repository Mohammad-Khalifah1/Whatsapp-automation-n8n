# ==============================================================================
# PRODUCTION environment — VPS deployment
#
# On the server:  cp .env.prod.example .env  &&  nano .env
#
# This file is committed and contains ONLY placeholders. The real `.env` on the
# server is git-ignored and must never leave it.
#
# Full walkthrough: docs/DEPLOYMENT_HOSTINGER.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain and TLS  (required)
# ------------------------------------------------------------------------------
# The hostname pointing at this VPS. Its DNS A record must already resolve to
# the server's public IP BEFORE first start — Caddy needs it to pass the ACME
# challenge and will fail repeatedly, and get rate-limited, if it does not.
DOMAIN=wa.example.com

# Let's Encrypt uses this only for expiry warnings. A real mailbox you read.
ACME_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Access control  (required — think about this one)
# ------------------------------------------------------------------------------
# Source IPs allowed to reach the n8n editor and the agent send endpoint.
# Space-separated; CIDR notation accepted.
#
# The Meta webhook is NOT affected by this — it stays public, protected by its
# HMAC signature instead, because Meta's source IPs change without notice.
#
# Find your current IP:  curl -4 ifconfig.me
#
# WARNING: a home connection usually has a dynamic IP. If yours changes you
# will lock yourself out of the editor — recover by SSHing in and editing this
# value, then `docker compose -f docker-compose.prod.yml restart caddy`.
# A VPN or office static IP is better. Never use 0.0.0.0/0 here.
ADMIN_ALLOWED_IPS=203.0.113.5 198.51.100.0/24

# ------------------------------------------------------------------------------
# n8n  (required)
# ------------------------------------------------------------------------------
# 64 hex characters. Generate ONCE with: openssl rand -hex 32
#
# Back this up somewhere other than the server. A server backup without this
# key cannot decrypt its own stored credentials, which makes the backup close
# to useless. Do NOT reuse the development key.
N8N_ENCRYPTION_KEY=

TZ=Asia/Amman
GENERIC_TIMEZONE=Asia/Amman

# -1 = no limit. NEVER 1. A limit of 1 was meant to serialise assignment,
# because Google Sheets has no compare-and-set — and it did, by DROPPING the
# overflow: under a burst, webhooks got HTTP 200 and then produced no row, no
# message and no log entry. Measured on the live deployment. The races are
# repaired instead: load is counted live from the rows, and workflow 8 folds
# duplicate conversations back together. See docs/ASSIGNMENT_ALGORITHM.md.
N8N_CONCURRENCY_PRODUCTION_LIMIT=-1

# --- Execution history retention ---
# Executions contain customer phone numbers and message text, so this is a
# data-retention decision, not only a disk one. 336 hours = 14 days.
EXECUTIONS_RETENTION_HOURS=336
EXECUTIONS_MAX_COUNT=20000

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API  (required)
# ------------------------------------------------------------------------------
META_GRAPH_API_VERSION=v26.0

# Use a SYSTEM USER token with expiry "Never".
# The temporary token from the dashboard dies after 24 hours and will take
# production down with it.
META_ACCESS_TOKEN=

# The Phone Number ID (a long number), not the phone number itself.
META_PHONE_NUMBER_ID=

META_WABA_ID=

# App Settings -> Basic -> App Secret. Without it every webhook is rejected,
# which is the system failing closed rather than accepting forged traffic.
META_APP_SECRET=

# A string you invent. Must match the value entered in the Meta dashboard.
WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# Google Sheets  (required)
# ------------------------------------------------------------------------------
# The service-account credential itself is created in the n8n UI, not here.
# Remember to share the spreadsheet with the service account's email.
GOOGLE_SHEET_ID=

# The same service account, for the appends that go through the Sheets API
# with INSERT_ROWS so simultaneous messages cannot overwrite each other.
# Without them every append falls back to the Sheets node.
# The private_key field from the JSON key, on ONE line, with literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Approved templates a person may send from the sheet by typing
# "[TEMPLATE] name" (or "[قالب] name") into reply_text. Only a name listed
# here is sent: a template costs money and Meta must have approved it.
# JSON on one line. params names the columns that fill {{1}}, {{2}} … in order.
# [{"name":"followup_general","language":"ar","category":"utility","params":["customer_name"]}]
WHATSAPP_TEMPLATES=

# ------------------------------------------------------------------------------
# Business logic
# ------------------------------------------------------------------------------
DEFAULT_COUNTRY_CODE=962
CONVERSATION_INACTIVITY_HOURS=24
ASSIGNMENT_STRATEGY=LEAST_OPEN_CONVERSATIONS
REOPEN_CLOSED_CONVERSATIONS=true
ARCHIVE_AFTER_DAYS=30
ARCHIVE_BATCH_SIZE=200
