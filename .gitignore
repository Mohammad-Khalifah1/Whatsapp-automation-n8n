# ==============================================================================
# Secrets — never commit these
# ==============================================================================
.env
.env.*
# Templates are the exception: they hold placeholders only and MUST be
# committed, or a new deployment has nothing to copy from.
!.env.example
!.env.prod.example
!*.example
*.pem
*.key
*.p12
*credentials*.json
service-account*.json
google-service-account*.json

# ==============================================================================
# n8n runtime data (persisted via Docker volume, not via bind mount by default)
# ==============================================================================
n8n_data/
.n8n/

# ==============================================================================
# OS / editor cruft
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/*
!.vscode/extensions.json

# ==============================================================================
# Node (for scripts/tests that use npm)
# ==============================================================================
node_modules/
npm-debug.log*
package-lock.json.bak

# ==============================================================================
# Python (for scripts/tests that use Python)
# ==============================================================================
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# ==============================================================================
# Logs and temp output
# ==============================================================================
*.log
logs/
tmp/
.tmp/
.secrets-tmp/

# ==============================================================================
# ngrok / tunnels
# ==============================================================================
ngrok.yml

# ==============================================================================
# Scratch files people paste credentials into.
# These are NOT a safe place for secrets — they exist because humans make them
# anyway, and an ignored file is far better than a committed one.
# Real secrets belong in .env (also ignored) or a password manager.
# ==============================================================================
# Case variants are listed explicitly: Git is case-sensitive on Linux, so a
# lowercase-only pattern would silently fail to protect SHEETKEYS.TXT on a
# colleague's machine or on the server even though it matches on Windows.
keys.txt
KEYS.TXT
keys.*
*keys.txt
*KEYS.TXT
*[Kk]eys.[Tt]xt
*[Kk][Ee][Yy][Ss]*
secrets.txt
*[Ss]ecret*.txt
token*.txt
*token.txt
*[Tt]oken*.txt
*credential*
*CREDENTIAL*
notes-credentials*
scratch*.txt
*service-account*
*.json.key

# Extension-less scratch files people drop credentials into. A pattern list
# can never be exhaustive, so `git status` before every commit and rely on
# scripts/validation/validate-workflows.js to scan for secret shapes.
/meta
/metaKeys
/creds
/tokens
/secret
/auth
/accesstoken
/accessToken
/access_token
/token
/apikey
/api_key
/appsecret
/app_secret
/password*
/private*

# ==============================================================================
# Extension-less scratch files at the repo root.
#
# Chasing individual names (meta, accesstoken, newtoken, ...) lost the race
# repeatedly. Ignore every extension-less root file, then re-include the few
# that belong in version control BY NAME.
#
# Deliberately NOT using `!/*.*` to re-include dotted files: that pattern also
# re-includes .env, keys.txt and SHEETKEYS.TXT. It was tried, it staged .env,
# and it is exactly the mistake this block exists to prevent.
# ==============================================================================
/*
!/*/
!/.gitignore
!/.gitattributes
!/.env.example
!/.env.prod.example
!/*.md
!/*.yml
!/*.yaml
!/*.json
!/*.js
!/Caddyfile
!/LICENSE
# GitHub Pages entry point. Named explicitly rather than !/*.html so a stray
# HTML file can never be swept in by a wildcard.
!/index.html

# Re-assert the secret rules LAST so nothing above can resurrect them.
.env
.env.*
!.env.example
!.env.prod.example
keys.txt
KEYS.TXT
*[Kk][Ee][Yy][Ss]*
*credential*
*service-account*
