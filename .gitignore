# ==============================================================================
# Secrets — never commit these
# ==============================================================================
.env
.env.*
# Templates are the exception: they hold placeholders only and MUST be
# committed, or a new deployment has nothing to copy from.
!.env.example
!.env.prod.example
!*.example
*.pem
*.key
*.p12
*credentials*.json
service-account*.json
google-service-account*.json

# ==============================================================================
# n8n runtime data (persisted via Docker volume, not via bind mount by default)
# ==============================================================================
n8n_data/
.n8n/

# ==============================================================================
# OS / editor cruft
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/*
!.vscode/extensions.json

# ==============================================================================
# Node (for scripts/tests that use npm)
# ==============================================================================
node_modules/
npm-debug.log*
package-lock.json.bak

# ==============================================================================
# Python (for scripts/tests that use Python)
# ==============================================================================
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# ==============================================================================
# Logs and temp output
# ==============================================================================
*.log
logs/
tmp/
.tmp/
.secrets-tmp/

# ==============================================================================
# ngrok / tunnels
# ==============================================================================
ngrok.yml

# ==============================================================================
# Scratch files people paste credentials into.
# These are NOT a safe place for secrets — they exist because humans make them
# anyway, and an ignored file is far better than a committed one.
# Real secrets belong in .env (also ignored) or a password manager.
# ==============================================================================
# Case variants are listed explicitly: Git is case-sensitive on Linux, so a
# lowercase-only pattern would silently fail to protect SHEETKEYS.TXT on a
# colleague's machine or on the server even though it matches on Windows.
keys.txt
KEYS.TXT
keys.*
*keys.txt
*KEYS.TXT
*[Kk]eys.[Tt]xt
*[Kk][Ee][Yy][Ss]*
secrets.txt
*[Ss]ecret*.txt
token*.txt
*token.txt
*[Tt]oken*.txt
*credential*
*CREDENTIAL*
notes-credentials*
scratch*.txt
*service-account*
*.json.key

# Extension-less scratch files people drop credentials into. A pattern list
# can never be exhaustive, so `git status` before every commit and rely on
# scripts/validation/validate-workflows.js to scan for secret shapes.
/meta
/metaKeys
/creds
/tokens
/secret
/auth
